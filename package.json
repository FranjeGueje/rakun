{
  "name": "relicd",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "relicd - headless Linux games installer service for GOG, Epic Games, Amazon Games and Zoom",
  "repository": {
    "type": "Github",
    "url": "https://github.com/FranjeGueje/Relic"
  },
  "author": {
    "name": "Relic",
    "email": "fjgj1@hotmail.com"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "start": "node build/relicd.cjs",
    "build": "pnpm build:daemon && pnpm build:ctl",
    "build:daemon": "esbuild src/backend/relic/main.ts --bundle --platform=node --format=cjs --target=node24 --alias:i18next-fs-backend=./node_modules/i18next-fs-backend/cjs/index.js --outfile=build/relicd.cjs --log-level=warning",
    "build:ctl": "esbuild src/relicctl/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=build/relicctl.cjs --log-level=warning",
    "package": "bash scripts/package.sh",
    "codecheck": "tsc --noEmit",
    "test": "jest",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand --silent",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "i18n": "i18next-cli extract --quiet",
    "prepare": "husky",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "esbuild --bundle --platform=node --target=node24 meta/downloadHelperBinaries.ts --outfile=build/meta/downloadHelperBinaries.cjs --log-level=warning && node build/meta/downloadHelperBinaries.cjs",
    "check-helper-binaries": "esbuild --bundle --platform=node --target=node24 meta/downloadHelperBinaries.ts --outfile=build/meta/downloadHelperBinaries.cjs --log-level=warning && RELIC_CHECK=1 node build/meta/downloadHelperBinaries.cjs",
    "lint-translations": "esbuild --bundle --platform=node --target=node24 meta/lintTranslations.ts --outfile=build/meta/lintTranslations.cjs --log-level=warning && node build/meta/lintTranslations.cjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "easydl": "^1.2.0",
    "i18next": "^22.5.1",
    "i18next-fs-backend": "^2.6.7",
    "json5": "^2.2.3",
    "steam-shortcut-editor": "^3.1.3",
    "tmp": "^0.2.7",
    "zod": "4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.3",
    "@types/tmp": "^0.2.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "i18next-cli": "^1.67.9",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "type-fest": "^3.13.1",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "undici": "^8.11.2"
  }
}
