{
  "name": "relicd",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "relicd - headless Linux games installer service for GOG, Epic Games, Amazon Games and Zoom",
  "repository": {
    "type": "Github",
    "url": "https://github.com/FranjeGueje/Relic"
  },
  "author": {
    "name": "Relic",
    "email": "fjgj1@hotmail.com"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "start": "node build/relicd.cjs",
    "build": "pnpm build:daemon && pnpm build:ctl && pnpm build:web",
    "build:daemon": "esbuild src/backend/relic/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=build/relicd.cjs --log-level=warning",
    "build:ctl": "esbuild src/relicctl/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=build/relicctl.cjs --log-level=warning",
    "build:web": "esbuild web/src/main.tsx --bundle --format=esm --jsx=automatic --target=es2023 --minify --outfile=build/web/app.js --log-level=warning && cp web/index.html build/web/index.html",
    "package": "bash scripts/package.sh",
    "codecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "jest",
    "test-watch": "jest --watch --maxWorkers=25%",
    "test:ci": "jest --runInBand --silent",
    "lint": "eslint --cache .",
    "lint-fix": "eslint --fix --ext .tsx,ts ./src",
    "prepare": "husky",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "download-helper-binaries": "esbuild --bundle --platform=node --target=node24 meta/downloadHelperBinaries.ts --outfile=build/meta/downloadHelperBinaries.cjs --log-level=warning && NODE_USE_ENV_PROXY=1 node build/meta/downloadHelperBinaries.cjs",
    "check-helper-binaries": "esbuild --bundle --platform=node --target=node24 meta/downloadHelperBinaries.ts --outfile=build/meta/downloadHelperBinaries.cjs --log-level=warning && RELIC_CHECK=1 NODE_USE_ENV_PROXY=1 node build/meta/downloadHelperBinaries.cjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "json5": "^2.2.3",
    "steam-shortcut-editor": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.4.12",
    "type-fest": "^3.13.1",
    "typed-emitter": "^2.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
