{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "lib": ["esnext"],
    "types": ["node", "jest"],
    "sourceMap": true,
    "moduleResolution": "bundler",
    "paths": {
      "backend/*": ["./src/backend/*"],
      "common/*": ["./src/common/*"]
    },
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "importHelpers": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["**/__mocks__/**", "sign"]
}
